// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TaskType {
  STORY
  BUG
  TASK
  SUBTASK
  EPIC
  IMPROVEMENT
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  HIGHEST
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum TaskLinkType {
  BLOCKS
  RELATES_TO
  DUPLICATES
  DEPENDS_ON
  CAUSED_BY
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum NotificationType {
  WORKSPACE_CREATED
  WORKSPACE_UPDATED
  WORKSPACE_DELETED

  WORKSPACE_MEMBER_INVITED
  WORKSPACE_MEMBER_REMOVED

  WORKSPACE_ROLE_UPDATED

  WORKSPACE_INVITE_ACCEPTED
  WORKSPACE_INVITE_DECLINED

  PROJECT_CREATED
  PROJECT_MEMBER_ADDED
  PROJECT_DELETED
  PROJECT_UPDATED
  PROJECT_MEMBER_JOINED
  PROJECT_MEMBER_REMOVED
  PROJECT_MEMBER_INVITED

  SPRINT_CREATED
  SPRINT_UPDATED
  SPRINT_DELETED
  SPRINT_STARTED
  SPRINT_COMPLETED
  SPRINT_HEALTH

  TASK_ADDED_TO_SPRINT
  TASK_REMOVED_FROM_SPRINT

  TASK_CREATED
  TASK_UPDATED
  TASK_DELETED

  TASK_ASSIGNED
  TASK_UNASSIGNED
  TASK_STATUS_UPDATED

  TASK_MOVED_TO_SPRINT
  TASK_MOVED_TO_BACKLOG

  TASK_COMMENT_ADDED
  TASK_COMMENT_DELETED

  TASK_LINKED
  TASK_LINK_REMOVED
  TASK_LINK_UPDATED

  TASK_DUE_REMINDER
  TASK_OVERDUE
  TASK_COMMENT_MENTION
  TASK_COMMENT_REPLY

  SYSTEM
}

model Membership {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId      String @db.Uuid
  workspaceId String @db.Uuid

  role String @default("MEMBER")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, workspaceId])
}

model Workspace {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  slug        String  @unique
  description String?
  logoUrl     String?

  ownerId String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner            User              @relation("UserOwnedWorkspaces", fields: [ownerId], references: [id])
  members          Membership[]
  projects         Project[]
  workspaceInvites WorkspaceInvite[]
}

model ProjectMember {
  id String @id @default(uuid()) @db.Uuid

  projectId String @db.Uuid
  userId    String @db.Uuid

  role String @default("MEMBER")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model Project {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String?

  workspaceId String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  members ProjectMember[]

  tasks          Task[]
  sprints        Sprint[]
  projectInvites ProjectInvite[]
  comments       TaskComment[]   @relation("TaskCommentProject")

  @@index([workspaceId])
}

model ProjectInvite {
  id String @id @default(uuid()) @db.Uuid

  email String
  token String @unique()

  status InviteStatus @default(PENDING)

  projectId   String @db.Uuid
  invitedById String @db.Uuid

  expiresAt DateTime

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])

  invitedBy User @relation("ProjectInviteSender", fields: [invitedById], references: [id])
}

model User {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String @unique
  passwordHash String

  name        String?
  avatarUrl   String?
  bio         String?
  designation String?
  timezone    String?

  isSuperAdmin Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resetToken       String?
  resetTokenExpiry DateTime?

  memberships     Membership[]
  ownedWorkspaces Workspace[]  @relation("UserOwnedWorkspaces")

  projectMembers ProjectMember[]

  reportedTasks Task[] @relation("TaskReporter")

  assignedTasks Task[]   @relation("TaskAssignee")
  sprints       Sprint[] @relation("SprintCreatedBy")

  taskComments TaskComment[]

  sentProjectInvites     ProjectInvite[]         @relation("ProjectInviteSender")
  sentWorkspaceInvites   WorkspaceInvite[]       @relation("WorkspaceInviteSender")
  notifications          Notification[]
  triggeredNotifications Notification[]          @relation("NotificationTriggeredBy")
  taskAttachments        TaskAttachment[]
  taskCommentAttachments TaskCommentAttachment[]
}

model Task {
  id String @id @default(uuid()) @db.Uuid

  title       String
  description String?

  taskKey String @unique

  projectId String @db.Uuid

  reporterId String @db.Uuid

  assigneeId String? @db.Uuid

  type     TaskType     @default(TASK)
  priority TaskPriority @default(MEDIUM)
  status   TaskStatus   @default(TODO)

  dueDate DateTime?

  estimateMinutes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  reporter User @relation("TaskReporter", fields: [reporterId], references: [id])

  assignee User? @relation("TaskAssignee", fields: [assigneeId], references: [id])

  comments TaskComment[]
  sprintId String?

  sprint Sprint? @relation(fields: [sprintId], references: [id])

  linkedTasks     TaskLink[] @relation("SourceTask")
  linkedFromTasks TaskLink[] @relation("TargetTask")

  dueReminderSent Boolean @default(false)

  overdueReminderSent Boolean @default(false)

  attachments TaskAttachment[]

  @@index([sprintId])
}

model TaskAttachment {
  id String @id @default(uuid())

  taskId String? @db.Uuid
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  uploadedById String @db.Uuid
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  fileName String
  fileUrl  String

  createdAt DateTime @default(now())

  @@index([taskId])
}

model TaskComment {
  id String @id @default(uuid()) @db.Uuid

  taskId String @db.Uuid
  userId String @db.Uuid

  content  String
  mentions String[] @default([])

  parentId String? @db.Uuid

  parent  TaskComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies TaskComment[] @relation("CommentReplies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String  @db.Uuid
  sprintId  String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, name: "TaskCommentProject")

  sprint Sprint? @relation(fields: [sprintId], references: [id], onDelete: Cascade, name: "TaskCommentSprint")

  attachments TaskCommentAttachment[]

  @@index([taskId])
  @@index([parentId])
}

model TaskCommentAttachment {
  id String @id @default(uuid())

  commentId String      @db.Uuid
  comment   TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  uploadedById String @db.Uuid
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  fileName String
  fileUrl  String

  createdAt DateTime @default(now())
}

model SprintSnapshot {
  id String @id @default(cuid())

  sprintId String
  sprint   Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  remainingEstimate Int

  createdAt DateTime @default(now())

  @@index([sprintId])
}

model Sprint {
  id String @id @default(cuid())

  name String
  goal String?

  status SprintStatus @default(PLANNED)

  startDate DateTime?
  endDate   DateTime?

  startedAt   DateTime?
  completedAt DateTime?

  createdById String @db.Uuid

  createdBy User @relation("SprintCreatedBy", fields: [createdById], references: [id])

  projectId String @db.Uuid

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tasks     Task[]
  snapshots SprintSnapshot[]
  comments  TaskComment[]    @relation("TaskCommentSprint")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  healthNotificationSent Boolean @default(false)
}

model TaskLink {
  id String @id @default(uuid()) @db.Uuid

  sourceTaskId String @db.Uuid
  targetTaskId String @db.Uuid

  type TaskLinkType

  sourceTask Task @relation("SourceTask", fields: [sourceTaskId], references: [id])

  targetTask Task @relation("TargetTask", fields: [targetTaskId], references: [id])
}

model WorkspaceInvite {
  id String @id @default(uuid()) @db.Uuid

  email String
  token String @unique

  role String @default("MEMBER")

  status InviteStatus @default(PENDING)

  workspaceId String @db.Uuid
  invitedById String @db.Uuid

  expiresAt DateTime

  createdAt DateTime @default(now())

  // =========================
  // RELATIONS
  // =========================

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  invitedBy User @relation("WorkspaceInviteSender", fields: [invitedById], references: [id])

  @@index([workspaceId])
}

model Notification {
  id String @id @default(uuid()) @db.Uuid

  title   String
  message String

  type NotificationType

  isRead Boolean @default(false)

  // receiver
  userId String? @db.Uuid

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  // who triggered event
  triggeredById String? @db.Uuid

  triggeredBy User? @relation("NotificationTriggeredBy", fields: [triggeredById], references: [id])

  workspaceId String? @db.Uuid
  projectId   String? @db.Uuid
  sprintId    String?
  taskId      String? @db.Uuid
  commentId   String? @db.Uuid

  redirectUrl String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([projectId])
  @@index([taskId])
  @@index([createdAt])
}
